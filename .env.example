# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-me-with-a-64-char-random-string

# Get a free key at https://console.groq.com/
GROQ_API_KEY=gsk_...

# ── Optional (defaults shown) ──────────────────────────────────────────────────

# Override the Postgres connection string (already set in docker-compose for Docker)
# DATABASE_URL=postgresql+asyncpg://guitar:guitar@db:5432/guitar_tutor

# Override the Postgres password used by the db service
# POSTGRES_PASSWORD=guitar

# Production guard: on Cloud Run (K_SERVICE is set) or with APP_ENV=production the
# backend refuses to start without JWT_SECRET_KEY.
# APP_ENV=production

# ── Password reset email ──────────────────────────────────────────────────────
# Without RESEND_API_KEY the reset email is written to the backend log instead.
# RESEND_API_KEY=re_...
# MAIL_FROM=AI Guitar Tutor <no-reply@yourdomain.com>
# Base URL used in the emailed reset link
# FRONTEND_URL=http://localhost:3000
